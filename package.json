{
  "name": "restaurant-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:customer\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema server/prisma/schema.prisma",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma",
    "preview": "vite preview --config client/vite.config.ts",
    "test:integration": "tsx --test server/src/index.test.ts",
    "dev:customer": "vite --config apps/customer/vite.config.ts",
    "build:customer": "tsc -p apps/customer/tsconfig.json && vite build --config apps/customer/vite.config.ts",
    "build:customer:vercel": "tsc -p apps/customer/tsconfig.json && vite build --config apps/customer/vercel.vite.config.ts"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^3.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest"
  },
  "prisma": {
    "seed": "tsx server/prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "zod": "^4.1.5"
  }
}
